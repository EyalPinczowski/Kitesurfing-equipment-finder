# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Path to the Facebook cookies JSON exported from your browser
FB_COOKIES_PATH=secrets/fb_cookies.json
# Where the database, media and logs live (default: ./data)
KITEFINDER_DATA_DIR=data
# Optional Gemini settings (defaults: gemini-2.5-flash, 8 calls/minute, 200 calls/day).
# Run `kitefinder llm models` to see which models your free key can use.
GEMINI_MODEL=
GEMINI_RPM=
GEMINI_RPD=
